{
    "generators": [
        {
            "name": "genCardHolders",
            "connection": "cardHolderWebhook",
            "vars": {
                "id": {
                    "_gen": "uuid"
                }
            },
            "url": "http://lhbank-cardholder-app:8082/api/cardHolders",
            "method": "POST",
            "data": {
                "id": {
                    "_gen": "var",
                    "var": "id"
                },
                "firstName": {
                    "_gen": "string",
                    "expr": "#{Name.firstName}"
                },
                "lastName": {
                    "_gen": "string",
                    "expr": "#{Name.lastName}"
                },
                "emailAddress": {
                    "_gen": "string",
                    "expr": "#{Internet.emailAddress}"
                },                
                "phoneNumber": {
                    "_gen": "string",
                    "expr": "#{PhoneNumber.cellPhoneInternational}"
                },               
                "preferredContact": {
                    "_gen": "oneOf",
                    "choices": [
                        "email",
                        "phone"
                    ]
                },               
                "avgTransactionAmount": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 19,
                            "value": {
                                "_gen": "uniformDistribution",
                                "bounds": [
                                    1,
                                    1000
                                ],
                                "decimals": 0
                            }
                        },
                        {
                            "weight": 1,
                            "value": {
                                "_gen": "normalDistribution",
                                "mean": 3000,
                                "sd": 500,
                                "decimals": 0
                            }
                        }
                    ]
                },
                "segment": {
                    "_gen": "oneOf",
                    "choices": [
                        "bronze",
                        "silver",
                        "gold",
                        "platinum"
                    ]
                },
                "addresses": {
                    "_gen": "repeatedly",
                    "n": {
                        "_gen": "uniformDistribution",
                        "bounds": [
                            1,
                            5
                        ],
                        "decimals": 0
                    },
                    "target": {
                        "street": {
                            "_gen": "string",
                            "expr": "#{Address.streetName}"
                        },
                        "zipCode": {
                            "_gen": "string",
                            "expr": "#{Address.zipCode}"
                        },
                        "city": {
                            "_gen": "string",
                            "expr": "#{Address.city}"
                        },
                        "state": {
                            "_gen": "string",
                            "expr": "#{Team.state}"
                        }
                    }
                },
                "usualCountries": {
                    "_gen": "repeatedly",
                    "n": 5,
                    "target": {
                        "_gen": "oneOf",
                        "choices": [
                            "DE",
                            "CH",
                            "GB",
                            "IE",
                            "FR",
                            "BE",
                            "NL",
                            "IT",
                            "GI",
                            "MT",
                            "AT",
                            "ES",
                            "PT",
                            "LI",
                            "DK",
                            "SE",
                            "NO",
                            "FI"
                        ]
                    },
                    "sample": {
                        "rate": 0.5
                    }
                },
                "onboardedDate": {
                    "_gen": "now"
                }
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        40000,
                        120000
                    ]
                }
            }
        },
        {
            "name": "genCardNumbers",
            "connection": "pg",
            "table": "card_numbers",
            "row": {
                "number": {
                    "_gen": "string",
                    "expr": "#{Business.creditCardNumber}"
                },
                "type": {
                    "_gen": "string",
                    "expr": "#{Business.creditCardType}"
                },
                "expiry_date": {
                    "_gen": "string",
                    "expr": "#{Business.creditCardExpiry}"
                }
            },
            "localConfigs": {
                "maxEvents": 1000,
                "throttleMs": 0
            }
        },
        {
            "name": "genCards",
            "connection": "cardWebhook",
            "url": "http://lhbank-cardholder-app:8082/api/cards",
            "method": "POST",
            "fork": {
                "key": {
                    "_gen": "lookup",
                    "name": "genCardHolders",
                    "path": ["data", "id"]
                },
                "stagger": {
                    "ms": {
                        "_gen": "uniformDistribution",
                        "bounds": [0, 50000]
                    }
                }
            },
            "vars": {
                "card_number": {
                    "_gen": "lookup",
                    "name": "genCardNumbers",
                    "path": ["row", "number"]
                }
            },
            "data": {
                "cardHolderId": {
                    "_gen": "var",
                    "var": "forkKey"
                },
                "number": {
                    "_gen": "var",
                    "var": "card_number"
                },
                "type": {
                    "_gen": "string",
                    "expr": "#{Business.creditCardType}"
                },
                "expiryDate": {
                    "_gen": "string",
                    "expr": "#{Business.creditCardExpiry}"
                }
            },
            "localConfigs": {
                "maxEvents": {
                    "_gen": "uniformDistribution",
                    "bounds": [1, 4],
                    "decimals": 0
                },
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [3600000, 86400000]
                }
            }
        },
        {
            "name": "genBlacklistedMerchants",
            "connection": "pg",
            "table": "blacklisted_merchants",
            "row": {
                "merchant_id": {
                    "_gen": "lookup",
                    "name": "genMerchants",
                    "path": [
                        "row", "merchant_id"
                    ]
                },

                "created_at": {
                    "_gen": "now",
                    "serialize": {
                        "type": "postgresTimestamp"
                    },
                    "pgHint": "TIMESTAMP"
                },
                "modified_at": {
                    "_gen": "now",
                    "serialize": {
                        "type": "postgresTimestamp"
                    },
                    "pgHint": "TIMESTAMP"
                }
            },
            "localConfigs": {
                "maxEvents": 1,
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        1000,
                        5000
                    ]
                }
            }
        },
        {
            "name": "genMerchants",
            "connection": "pg",
            "table": "merchants",
            "vars": {
                "merchant_id": {
                    "_gen": "sequentialString",
                    "expr": "merchant-~d"
                }
            },
            "row": {
                "merchant_id": {
                    "_gen": "var",
                    "var": "merchant_id",
                    "pgHint": "TEXT PRIMARY KEY"
                },
                "name": {
                    "_gen": "string",
                    "expr": "#{Company.name}"
                },
                "country": {
                    "_gen": "string",
                    "expr": "#{Address.countryCode}"
                },
                "city": {
                    "_gen": "string",
                    "expr": "#{Address.city}"
                },
                "category_name": {
                    "_gen": "string",
                    "expr": "#{Commerce.department}"
                },
                "status": "ACTIVE"
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        0,
                        10
                    ]
                },
                "maxEvents": 200
            }
        },
        {
            "name": "genCardTransactions",
            "connection": "kafka",
            "topic": "priv.pay.transaction.delta.v1",
            "vars": {
                "card_number": {
                    "_gen": "lookup",
                    "name": "genCardNumbers",
                    "path": [
                        "row", "number"
                    ]
                },
                "merchant_id": {
                    "_gen": "lookup",
                    "name": "genMerchants",
                    "path": [
                        "row", "merchant_id"
                    ]
                }
            },
            "key": {
                "_gen": "var",
                "var": "card_number"
            },
            "value": {
                "transaction_id": {
                    "_gen": "uuid"
                },
                "card_number": {
                    "_gen": "var",
                    "var": "card_number"
                },
                "merchant_id": {
                    "_gen": "var",
                    "var": "merchant_id"
                },
                "amount": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 19,
                            "value": {
                                "_gen": "uniformDistribution",
                                "bounds": [
                                    1,
                                    300
                                ]
                            }
                        },
                        {
                            "weight": 1,
                            "value": {
                                "_gen": "normalDistribution",
                                "mean": 3000,
                                "sd": 500
                            }
                        }
                    ]
                },
                "currency": {
                    "_gen": "string",
                    "expr": "#{Country.currencyCode}"
                },
                "channel": {
                    "_gen": "oneOf",
                    "choices": [
                        "POS",
                        "e-commerce",
                        "ATM"
                    ]
                },
                "transaction_date": {
                    "_gen": "now"
                }
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        50,
                        500
                    ]
                }
            }
        }
    ],
    "schedule": {
        "stages": [
            {
                "generators": [
                    "genMerchants",
                    "genCardNumbers",
                    "genCardHolders"
                ],
                "overrides": {
                    "genCardHolders": {
                        "localConfigs": {
                            "maxEvents": 300,
                            "throttleMs": 0
                        }
                    }
                }
            },
            {
                "generators": [
                    "genCardHolders"
                ],
                "overrides": {
                    "genCardHolders": {
                        "localConfigs": {
                            "maxEvents": 2,
                            "throttleMs": 30000
                        }
                    }
                }
            },
            {
                "generators": [
                    "genCardHolders",
                    "genCards",
                    "genCardTransactions"
                ]
            }
        ]
    },
    "connections": {
        "kafka": {
            "kind": "kafka",
            "topicPolicy": {
                "policy": "create",
                "partitions": 2,
                "replicationFactor": 3,
                "topicConfigs": {
                    "retention.ms": "86400000"
                }
            },
            "producerConfigs": {
                "bootstrap.servers": {
                    "_gen": "env",
                    "var": "KAFKA_BOOTSTRAP_SERVERS"
                },
                "schema.registry.url": {
                    "_gen": "env",
                    "var": "KAFKA_SCHEMA_REGISTRY_URL"
                },
                "key.serializer": "io.confluent.kafka.serializers.KafkaAvroSerializer",
                "value.serializer": "io.confluent.kafka.serializers.KafkaAvroSerializer"
            }
        },
        "pg": {
            "kind": "postgres",
            "tablePolicy": "dropAndCreate",
            "connectionConfigs": {
                "host": {
                    "_gen": "env",
                    "var": "POSTGRESQL_HOST"
                },
                "port": {
                    "_gen": "env",
                    "var": "POSTGRESQL_PORT",
                    "as": "integer"
                },
                "db": {
                    "_gen": "env",
                    "var": "POSTGRESQL_DATABASE"
                },
                "username": {
                    "_gen": "env",
                    "var": "POSTGRESQL_USER"
                },
                "password": {
                    "_gen": "env",
                    "var": "POSTGRESQL_PASSWORD"
                }
            }
        },
        "cardHolderWebhook": {
            "kind": "webhook"
        },
        "cardWebhook": {
            "kind": "webhook"
        }

    }
}